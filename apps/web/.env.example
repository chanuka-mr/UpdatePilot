# Hosted API URL (use https:// in production, http://127.0.0.1:4010 locally).
BACKEND_API_URL="http://127.0.0.1:4010"

# Must match BACKEND_API_TOKEN on apps/api. Never prefix with NEXT_PUBLIC_.
BACKEND_API_TOKEN="REPLACE_WITH_AT_LEAST_32_RANDOM_HEX_CHARS"

# Public origin of this Next.js app (e.g. https://updatepilot.vercel.app).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public HTTPS API URL shown in agent pairing instructions.
NEXT_PUBLIC_AGENT_API_URL="https://api.updatepilot.example"
