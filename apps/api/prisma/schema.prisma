generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id        String              @id @default(uuid()) @db.Uuid
  key       String              @unique
  name      String
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  scans     InventorySnapshot[]
  agents    AgentCredential[]
  pairings  PairingTicket[]
  scanJobs  ScanJob[]
}

model AgentCredential {
  id          String   @id @default(uuid()) @db.Uuid
  deviceId    String   @db.Uuid
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  jobs        ScanJob[]
}

model PairingTicket {
  id         String    @id @default(uuid()) @db.Uuid
  deviceId   String    @db.Uuid
  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  usedAt     DateTime? @db.Timestamptz(3)
}

model ScanJob {
  id           String           @id @default(uuid()) @db.Uuid
  deviceId     String           @db.Uuid
  device       Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  agentId      String?          @db.Uuid
  agent        AgentCredential? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  state        String
  operation    String           @default("scan")
  request      Json?
  preview      Json?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  expiresAt    DateTime         @db.Timestamptz(3)
  startedAt    DateTime?        @db.Timestamptz(3)
  finishedAt   DateTime?        @db.Timestamptz(3)
  leaseHash    String?
  snapshotId   String?          @db.Uuid
  resultHash   String?
  error        String?

  @@index([deviceId, createdAt(sort: Desc)])
}

model InventorySnapshot {
  id           String                @id @default(uuid()) @db.Uuid
  deviceId     String                @db.Uuid
  device       Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scannedAt    DateTime              @db.Timestamptz(3)
  importedAt   DateTime              @default(now()) @db.Timestamptz(3)
  contentHash  String
  wingetStatus String
  warnings     Json
  raw          Json
  applications RegistryApplication[]
  packages     WinGetPackage[]

  @@unique([deviceId, contentHash])
  @@unique([deviceId, scannedAt])
  @@index([deviceId, scannedAt(sort: Desc)])
}

model RegistryApplication {
  id               String            @id @default(uuid()) @db.Uuid
  snapshotId       String            @db.Uuid
  snapshot         InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  name             String
  installedVersion String?
  publisher        String?
  scope            String
  registryView     String
  registryPath     String
  discoverySource  String
  matchStatus      String

  @@unique([snapshotId, scope, registryView, registryPath])
  @@index([snapshotId, name])
}

model WinGetPackage {
  id                String            @id @default(uuid()) @db.Uuid
  snapshotId        String            @db.Uuid
  snapshot          InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  packageId         String
  name              String
  installedVersion  String?
  source            String?
  isUpdateAvailable Boolean
  availableVersions String[]
  matchStatus       String

  @@index([snapshotId, isUpdateAvailable])
  @@index([snapshotId, packageId])
}
