# PostgreSQL connection URL (use managed PostgreSQL with SSL in production).
# Never put this URL in frontend configuration or NEXT_PUBLIC_* variables.
DATABASE_URL="postgresql://updatepilot:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/updatepilot?schema=public"

# Shared secret between Next.js (apps/web) and this API (at least 32 random chars).
BACKEND_API_TOKEN="REPLACE_WITH_AT_LEAST_32_RANDOM_HEX_CHARS"

PORT=4010
TRUST_PROXY="false"

# Milestone 1 private deployment gates:
# Set to "false" for a private single-account deployment, or "true" to allow public registration.
SIGNUP_ENABLED="true"
ALLOWED_SIGNUP_EMAILS=""
MAX_DEVICES_PER_USER="1"

# Keep disabled until architecture and installer signature verification are tested on a disposable VM.
# When false, /api/v1/control/update returns a structured blocked response and creates no job.
UPDATE_EXECUTION_ENABLED="false"
