# Replace the password locally. URL-encode special characters in credentials.
# Never put this URL in frontend configuration or NEXT_PUBLIC_* variables.
DATABASE_URL="postgresql://updatepilot:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5432/updatepilot?schema=public"

# Run node scripts/configure-local-api.mjs to generate the shared local API secret.
DEVICE_KEY="local-pc"
PORT=4010

# Keep disabled until architecture and installer signature verification are implemented.
# When false, /api/v1/control/update returns a structured blocked response and creates no job.
UPDATE_EXECUTION_ENABLED="false"
